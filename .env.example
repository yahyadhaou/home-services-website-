# Resend (https://resend.com) — API key for the contact form. Server-side only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact messages are delivered (defaults to dhaou.yahya98@gmail.com).
CONTACT_TO_EMAIL=dhaou.yahya98@gmail.com

# Sender address. Without a verified domain Resend only accepts onboarding@resend.dev,
# and only delivers to the e-mail address of your Resend account.
CONTACT_FROM_EMAIL="HomeServices Showcase <onboarding@resend.dev>"
