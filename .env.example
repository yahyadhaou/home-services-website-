# Contact form → Gmail (SMTP). Server-side only; never commit the real values.
# GMAIL_USER is the Gmail account that sends (and receives) the messages.
GMAIL_USER=dhaou.yahya98@gmail.com

# A Google "app password" (16 letters), NOT the normal account password.
# Create it at https://myaccount.google.com/apppasswords (needs 2-step verification).
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: deliver messages to a different inbox (defaults to GMAIL_USER).
# CONTACT_TO_EMAIL=dhaou.yahya98@gmail.com

# Optional: public URL used for the link in the confirmation e-mail (Netlify sets URL itself).
# NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
